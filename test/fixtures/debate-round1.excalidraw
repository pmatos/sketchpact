      "boundElements": [],
      "updated": 1790760121910,
      "link": null,
      "locked": false,
      "customData": {
        "sketchpactId": "ext_note_arg",
        "owner": "extensibility"
      },
      "text": "Seam only where an issue phase\nis the caller: P4 pipe (G3),\nmodular calls, hash builtin\n(G4). Lock what soundness and\nparity force. Loops get no seam.",
      "originalText": "Seam only where an issue phase is the caller: P4 pipe (G3), modular calls, hash builtin (G4). Lock what soundness and parity force. Loops get no seam.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "ab"
    },
    {
      "id": "ext_note_d1",
      "type": "text",
      "x": 2438,
      "y": 342,
      "width": 384,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 13645971,
      "version": 2,
      "versionNonce": 1956443020,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790760121910,
      "link": null,
      "locked": false,
      "customData": {
        "sketchpactId": "ext_note_d1",
        "owner": "extensibility"
      },
      "text": "D1 assumed (b): checker lives in\ncompiler/ only. Stage 0 keeps\nESBMC as oracle until P6.",
      "originalText": "D1 assumed (b): checker lives in compiler/ only. Stage 0 keeps ESBMC as oracle until P6.",
      "fontSize": 20,
      "fontFamily": 5,
