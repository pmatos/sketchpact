{
  "name": "sketchpact",
  "version": "0.1.0",
  "description": "A local-only shared Excalidraw whiteboard where Claude Code (over MCP) and a human design together and record the agreed decision.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "dev:server": "tsx src/server/main.ts",
    "dev:web": "vite",
    "build:web": "npm run assets && vite build",
    "assets": "node scripts/copy-assets.mjs",
    "postinstall": "node scripts/copy-assets.mjs",
    "debate": "node scripts/debate.mjs"
  },
  "keywords": ["excalidraw", "whiteboard", "mcp", "claude-code", "design", "architecture-decision-records"],
  "author": "Paulo Matos <p@ocmatos.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmatos/sketchpact.git"
  },
  "homepage": "https://github.com/pmatos/sketchpact#readme",
  "bugs": {
    "url": "https://github.com/pmatos/sketchpact/issues"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "elkjs": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
